{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Home Assistant on port 8123",
      "type": "shell",
      "command": "scripts/develop",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Run Home Assistant with Auto-Reload",
      "type": "shell",
      "command": "scripts/develop-watch",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Lint using ruff",
      "type": "shell",
      "command": "scripts/lint",
      "problemMatcher": []
    },
    {
      "label": "Test using pytest",
      "type": "shell",
      "command": "pytest",
      "problemMatcher": []
    },
    {
      "label": "Type check using mypy",
      "type": "shell",
      "command": "mypy",
      "args": ["custom_components/siku", "--ignore-missing-imports"],
      "problemMatcher": ["$mypy-python"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}